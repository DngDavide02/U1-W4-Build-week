<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.2"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
    <persistence-unit name="BWT4">
        <class>TEAM4.entities.Abbonamenti</class>
        <class>TEAM4.entities.Atac</class>
        <class>TEAM4.entities.Biglietti</class>
        <class>TEAM4.entities.Distributori</class>
        <class>TEAM4.entities.Emittenti</class>
        <class>TEAM4.entities.Manutenzione</class>
        <class>TEAM4.entities.Mezzi</class>
        <class>TEAM4.entities.Rivenditori</class>
        <class>TEAM4.entities.Tessera</class>
        <class>TEAM4.entities.Tratta</class>
        <class>TEAM4.entities.TipoMezzo</class>
        <class>TEAM4.entities.TipoAbbonamento</class>
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/BWT4"/>
            <property name="javax.persistence.jdbc.user" value="postgres"/>
            <property name="javax.persistence.jdbc.password" value="1234"/>
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="hibernate.default_schema" value="public"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL82Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>